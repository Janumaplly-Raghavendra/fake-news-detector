# ══════════════════════════════════════════
#  TruthLens – Fake News Detector
#  .gitignore
# ══════════════════════════════════════════

# ── Python ─────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual Environments ───────────────────
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ── Environment Variables ──────────────────
.env
.env.local
.env.production
*.env

# ── Dataset (large CSV files) ─────────────
dataset/Fake.csv
dataset/True.csv
dataset/*.csv
dataset/*.zip

# ── Trained Model Artifacts ───────────────
# Uncomment these if you do NOT want to track .pkl files in git
# (they can be large and regenerated by running train_model.py)
# models/model.pkl
# models/vectorizer.pkl
# *.pkl

# ── Debug / Temp Output ───────────────────
out.json
*.log
*.tmp
*.bak

# ── IDE & Editor Files ────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
.DS_Store
Thumbs.db

# ── Jupyter Notebooks (checkpoints) ───────
.ipynb_checkpoints/
*.ipynb

# ── pytest / Testing Cache ────────────────
.pytest_cache/
.coverage
htmlcov/
*.coveragerc

# ── mypy / type checkers ──────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Node (if any frontend tooling added) ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
